// Package httpapi is the service's transport layer: validate, authenticate, authorize, delegate,
// and nothing more. It owns no business decision.
package httpapi

import (
	"log/slog"
	"net/http"
	"time"
)

// ServerConfig holds everything NewServer needs. Add the interfaces the handlers consume here;
// they are declared by this package and satisfied by adapters wired in main.go.
type ServerConfig struct {
	Logger *slog.Logger
	// Ready reports whether the service can take traffic (database reachable, ...). Nil means
	// always ready.
	Ready func() error
}

// NewServer builds the top-level http.Handler: probes, then your routes, wrapped in request
// logging and panic recovery.
func NewServer(cfg ServerConfig) http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /healthz", healthz)
	mux.HandleFunc("GET /readyz", readyz(cfg.Ready))

	// Register routes here, e.g. mux.Handle("POST /v1/things", createThing(deps)).

	return logRequests(cfg.Logger, recoverPanics(cfg.Logger, mux))
}

func logRequests(logger *slog.Logger, next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		start := time.Now()
		rec := &statusRecorder{ResponseWriter: w, status: http.StatusOK}
		next.ServeHTTP(rec, r)
		logger.Info("request",
			"method", r.Method,
			"path", r.URL.Path,
			"status", rec.status,
			"duration_ms", time.Since(start).Milliseconds(),
		)
	})
}

func recoverPanics(logger *slog.Logger, next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if v := recover(); v != nil {
				logger.Error("panic recovered", "panic", v, "path", r.URL.Path)
				http.Error(w, "internal error", http.StatusInternalServerError)
			}
		}()
		next.ServeHTTP(w, r)
	})
}

type statusRecorder struct {
	http.ResponseWriter
	status int
}

func (r *statusRecorder) WriteHeader(code int) {
	r.status = code
	r.ResponseWriter.WriteHeader(code)
}
