{
	"name": "@ignition/components",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Shared, Tailwind-styled React component library consumed by Ignition's Vite apps as a workspace package.",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./theme.css": "./src/styles/theme.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"motion": "^13.4.6"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}
