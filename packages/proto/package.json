{
	"name": "@ignition/proto",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "TypeScript types and Connect service descriptors generated from /proto. Do not edit src/gen: run `pnpm gen:proto` at the repo root.",
	"exports": {
		"./*": "./src/gen/*.ts"
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.15.0",
		"@connectrpc/connect": "^2.2.0"
	},
	"devDependencies": {
		"@bufbuild/protoc-gen-es": "^2.15.0",
		"typescript": "^6.0.3"
	}
}
