{
	"name": "@ignition/mailer",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Transactional email: react.email templates, exported to static HTML for the Go mailer, plus a Resend sender for Node apps.",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "email dev --dir src/emails --port 3030",
		"export": "tsx scripts/export.tsx",
		"check:export": "tsx scripts/export.tsx --check",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@react-email/render": "^2.1.0",
		"react": "^19.3.0",
		"resend": "^6.30.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"react-email": "^6.11.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	}
}
